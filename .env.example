# Server
PORT=8080

# Firebase JWT (web app path)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SIGN_IN_PROVIDER=google.com

# Slack (events path)
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Vertex AI Agent Engine (prompt path)
AGENT_ENABLED=false
GCP_PROJECT=your-gcp-project
GCP_LOCATION=us-central1
REASONING_ENGINE_ID=your-reasoning-engine-id
AGENT_CLASS_METHOD=async_stream_query
AGENT_GE_AUTH_STATE_KEY=fetch-agent-auth

# User-scoped Google OAuth (workspace datastore ACLs)
# When set, orchestrator stores refresh tokens and resolves access tokens server-side.
USER_OAUTH_MODE=auto
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/v1/oauth/google/callback
GOOGLE_OAUTH_SUCCESS_REDIRECT=http://localhost:5670
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/cloud-platform
GOOGLE_OAUTH_ALLOWED_DOMAINS=reemahealth.com
